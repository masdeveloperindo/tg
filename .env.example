APP_NAME="Trader Garuda"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tg
DB_USERNAME=tg
DB_PASSWORD=
# Local development container only; never reuse a production credential here.
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Enable with HTTPS in staging/production; HTTP loopback development needs false.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Supplied later by owner/infra. No Telegram bot or production credentials.
TG_TELEGRAM_USERNAME=
TG_LICENSE_ED25519_PRIVATE_KEY_PATH=
TG_INDICATOR_SALES_ENABLED=false

# Exact HTTPS broker referral hostnames approved by owner/legal, comma-separated.
TG_BROKER_REFERRAL_HOSTS=
